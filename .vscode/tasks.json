{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Flutter App on Android Emulator",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_on_android_emulator.ps1"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}